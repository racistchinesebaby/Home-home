{
  "name": "tams",
  "version": "1.0.0",
  "description": "Terminal App Management System - Self-replicating AI-powered apps",
  "main": "dist/core/index.js",
  "bin": {
    "tams": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node cli/index.ts",
    "start": "node dist/cli/index.js",
    "watch": "tsc --watch",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\""
  },
  "keywords": [
    "terminal",
    "app-management",
    "ai",
    "self-replicating",
    "trading",
    "research",
    "automation",
    "web-scraping"
  ],
  "author": "TAMS Core",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "fs-extra": "^11.0.0",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
